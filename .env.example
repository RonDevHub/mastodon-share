# Available values: math, turnstile, cap
CAPTCHA_TYPE=math

# Required when CAPTCHA_TYPE=turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Required when CAPTCHA_TYPE=cap
# Enter the Cap server base URL, e.g. https://captcha.example.com
CAP_URL=
CAP_SITE_KEY=
CAP_SECRET_KEY=

# Optional trusted HTML inserted into the page <head>
# Example: <script defer src="xxxxxxxxxxxx"></script>
HEADER_CODE=
